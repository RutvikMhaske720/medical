# ==========================================
# MedhaJiva API & Environment Configuration
# ==========================================

# Google Gemini API Key (Required for SOAP generation & Symptom extraction)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Whisper Speech-to-Text Model (tiny, base, small, medium, large)
WHISPER_MODEL=tiny

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
